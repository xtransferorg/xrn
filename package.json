{
  "name": "xrn",
  "version": "1.0.0",
  "private": true,
  "author": "xrn",
  "license": "Apache-2.0",
  "scripts": {
    "build": "lerna run build --no-private",
    "clean": "lerna clean --yes && rm -rf node_modules",
    "start-doc": "cd docs && yarn dev",
    "postinstall": "yarn build",
    "list-beta-packages": "npx xrn-tools list-beta-packages",
    "version:beta": "lerna version prerelease --no-push --preid beta --no-private --yes",
    "version:prod": "lerna version --no-push --no-private",
    "version:fix": "npx lerna version 3.0.2 --force-publish --no-push --no-private",
    "publish:from-package": "lerna publish from-package --yes",
    "publish:from-package:beta": "lerna publish from-package --yes --npm-client-args=\"--tag beta\"",
    "start:local-registry": "lsof -ti:4873 | xargs kill -9 2>/dev/null; sleep 1; npx --yes verdaccio@6 --config .local-npm-registry/config.yaml",
    "publish:local-registry": "lerna publish from-package --yes --registry http://127.0.0.1:4873/ --npm-client-args=\"--userconfig=${INIT_CWD:-$PWD}/.local-npm-registry/npmrc --access public\"",
    "unpublish:local-registry": "lerna exec --no-private -- npm unpublish --force --registry http://127.0.0.1:4873/ --userconfig=${INIT_CWD:-$PWD}/.local-npm-registry/npmrc"
  },
  "resolutions": {
    "@types/react": "18.0.25",
    "@types/react-native": "0.72.8",
    "react": "18.3.1",
    "react-native": "0.77.1"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/@xrnjs/*",
      "!packages/@xrnjs/cli",
      "!packages/@xrnjs/app-update",
      "!packages/@xrnjs/core",
      "!packages/@xrnjs/devtools"
    ]
  },
  "dependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "yarn-deduplicate": "^6.0.2"
  },
  "devDependencies": {
    "@types/react": "18.0.25",
    "axios": "1.5.0",
    "exec-sh": "0.4.0",
    "lerna": "^8.2.1",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.7",
    "patch-package": "^8.0.0",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "simple-git-hooks": "^2.13.0",
    "standard-version": "9.5.0"
  },
  "volta": {
    "node": "20.12.2"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "packageManager": "yarn@3.6.1"
}
