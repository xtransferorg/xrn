{
  app: {
    products: [
      {
        name: 'default',
        compatibleSdkVersion: '5.0.1(13)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
      {
        name: 'dev',
        compatibleSdkVersion: '5.0.1(13)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
      {
        name: 'prod',
        compatibleSdkVersion: '5.0.1(13)',
        runtimeOS: 'HarmonyOS',
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      }
    ],
    buildModeSet: [
      {
        name: 'debug',
      },
      {
        name: 'release',
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
        {
          name: 'dev',
          applyToProducts: [
            'dev',
          ],
        },
        {
          name: 'prod',
          applyToProducts: [
            'prod',
          ],
        }
      ],
    },
    {
      name: 'config',
      srcPath: '../node_modules/@react-native-ohos/react-native-config/harmony/config',
    },
    {
      name: 'device_info',
      srcPath: '../node_modules/@react-native-ohos/react-native-device-info/harmony/device_info',
    },
    {
      name: 'pdfview',
      srcPath: '../node_modules/@react-native-ohos/react-native-pdf/harmony/pdfview',
    },
    {
      name: 'get_random_values',
      srcPath: '../node_modules/@react-native-ohos/react-native-get-random-values/harmony/get_random_values',
    },
    {
      name: 'blobUtil',
      srcPath: '../node_modules/@react-native-ohos/react-native-blob-util/harmony/blobUtil',
    },
    {
      name: 'xrn_loading',
      srcPath: '../node_modules/xrn-loading/harmony/xrn_loading',
    },
    {
      name: 'xrn_debug_tools',
      srcPath: '../node_modules/xrn-debug-tools/harmony/xrn_debug_tools',
    },
    {
      name: 'xrn_native_storage',
      srcPath: '../node_modules/xrn-native-storage/harmony/xrn_native_storage',
    },
    {
      name: 'xrn_multi_bundle',
      srcPath: '../node_modules/xrn-multi-bundle/harmony/xrn_multi_bundle',
    },
    {
      name: 'xrn_bundle',
      srcPath: '../node_modules/xrn-bundle/harmony/xrn_bundle',
    },
    {
      name: 'xrn_app_utils',
      srcPath: '../node_modules/xrn-app-utils/harmony/xrn_app_utils',
    },
    {
      name: 'xrn_navigation',
      srcPath: '../node_modules/xrn-navigation/harmony/xrn_navigation',
    },
    {
      "name": "codePush",
      "srcPath": "../node_modules/@xrnjs/react-native-code-push/harmony/codePush"
    },
    {
      "name": "xrn_keyboard",
      "srcPath": "../node_modules/xrn-keyboard/harmony/xrn_keyboard"
    },
    {
      "name": 'xrn_image',
      "srcPath": '../node_modules/xrn-image/harmony/xrn_image'
    }
  ],
}
