{
  "name": "xrngo",
  "version": "0.0.1",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "codegen": "react-native codegen-harmony --cpp-output-path ./harmony/entry/src/main/cpp/generated --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony",
    "bundle:common": "xrn build-common-bundle ios",
    "build:harmony": "xrn build xrngo harmony --type debug --appFormat hap",
    "build:android": "xrn build xrngo android --type debug --appFormat apk",
    "build:android:release": "xrn build xrngo android --type release --appFormat apk",
    "build:ios": "xrn build xrngo ios --type debug --appFormat ipa",
    "build:ios:sim": "xrn build xrngo ios --type debug --appFormat app",
    "postinstall": "npx xrn postinstall android ios harmony"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "dependencies": {
    "@xrnjs/cli": "0.1.0",
    "@xrnjs/core": "0.1.0"
  },
  "devDependencies": {
    "@react-native-oh/react-native-harmony-cli": "0.77.33-1",
    "@react-native/metro-config": "0.77.1"
  },
  "resolutions": {
    "react-native": "0.77.1",
    "react-native-view-shot": "4.0.3",
    "@xrnjs/bundle": "0.1.0",
    "@xrnjs/debug-tools": "0.1.0",
    "@xrnjs/image": "0.1.0",
    "@xrnjs/navigation": "0.1.0"
  },
  "harmony": {
    "codegenConfig": {
      "specPaths": [
        "./src"
      ]
    }
  },
  "codegenConfig": {
    "name": "XrnAppSpec",
    "type": "all",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.xrn"
    },
    "ios": {
      "componentProvider": {}
    }
  }
}
