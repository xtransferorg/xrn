{
  "name": "@xrnjs/asset-loader",
  "version": "0.1.0",
  "description": "资源加载",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "autoDeployAPIDocs": true,
  "scripts": {
    "build-deps": "npx xrn-tools build-dep-packages @xrnjs/asset-loader",
    "build": "xrn-module build",
    "clean": "xrn-module clean",
    "lint": "xrn-module lint",
    "prepare": "npx xrn-module prepare",
    "xrn-module": "xrn-module",
    "yalcPublish": "npx yalc publish --push",
    "watch": "nodemon --ignore build/ --ignore lib/ --ignore node_modules/ --watch ./ -C -e js,jsx,ts,tsx,css,less --debug -x 'yarn build && yalc push'"
  },
  "files": [
    "src",
    "build",
    "android",
    "ios",
    "harmony/*.har",
    "harmony/xrn_asset_loader",
    "!harmony/xrn_asset_loader/oh_modules",
    "!harmony/xrn_asset_loader/build",
    "!harmony/xrn_asset_loader/.hvigor",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "xrn",
    "@xrnjs/asset-loader",
    "XRNAssetLoader"
  ],
  "repository": "https://github.com/xtransferorg/xrn",
  "bugs": {
    "url": "https://github.com/xtransferorg/xrn/issues"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://github.com/xtransferorg/xrn#readme",
  "devDependencies": {
    "@react-native-oh/react-native-harmony": "0.77.33",
    "@types/react": "^18.2.6",
    "lodash": "^4.17.21",
    "nodemon": "^3.1.1",
    "react-native": "0.77.1",
    "xrn-module-scripts": "*",
    "xrn-tools": "*"
  },
  "peerDependencies": {
    "@xrnjs/modules-core": "*",
    "lodash": "*",
    "react": "*",
    "react-native": "*",
    "react-native-code-push": "*"
  },
  "xrnMeta": {
    "name": "XRNAssetLoader",
    "title": "My new module",
    "showName": "XRNAssetLoader",
    "group": "资源管理",
    "description": "My new module",
    "packageName": "@xrnjs/asset-loader",
    "sdkPath": "resource-management/@xrnjs/asset-loader"
  },
  "codegenConfig": {
    "name": "RNPAssetsLoadSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "xrn.modules.assetloader"
    }
  }
}
