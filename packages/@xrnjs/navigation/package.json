{
  "name": "@xrnjs/navigation",
  "version": "0.1.0",
  "description": "提供应用内导航管理，支持多种路由方式",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "autoDeployAPIDocs": true,
  "scripts": {
    "build-deps": "npx xrn-tools build-dep-packages @xrnjs/navigation",
    "build": "xrn-module build",
    "clean": "xrn-module clean",
    "lint": "xrn-module lint",
    "prepare": "npx xrn-module prepare",
    "xrn-module": "xrn-module",
    "yalcPublish": "npx yalc publish --push",
    "watch": "nodemon --ignore build/ --ignore lib/ --ignore node_modules/ --watch ./ -C -e js,jsx,ts,tsx,css,less --debug -x 'yarn build && yalc push'"
  },
  "files": [
    "patches",
    "assets",
    "src",
    "build",
    "android",
    "ios",
    "harmony/*.har",
    "harmony/xrn_navigation",
    "!harmony/xrn_navigation/oh_modules",
    "!harmony/xrn_navigation/build",
    "!harmony/xrn_navigation/.hvigor",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "xrn",
    "@xrnjs/navigation",
    "XRNNavigation"
  ],
  "repository": "https://github.com/xtransferorg/xrn",
  "bugs": {
    "url": "https://github.com/xtransferorg/xrn/issues"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://xtransferorg.github.io/versions/latest/sdk/routing-navigation/@xrnjs/navigation",
  "dependencies": {
    "@react-navigation/bottom-tabs": "6.6.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/stack": "6.4.1",
    "lodash": "4.17.21",
    "nanoid": "4.0.2",
    "react-native-tab-view": "3.5.2",
    "url-parse": "1.5.10",
    "warn-once": "0.1.1"
  },
  "devDependencies": {
    "@types/url-parse": "1.4.11",
    "xrn-module-scripts": "*"
  },
  "peerDependencies": {
    "@xrnjs/modules-core": "*",
    "react": "*",
    "react-native": "*",
    "react-native-gesture-handler": "*",
    "react-native-reanimated": "*",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*"
  },
  "harmony": {
    "codegenConfig": {
      "specPaths": [
        "./src"
      ]
    }
  },
  "codegenConfig": {
    "name": "XRNNavigationModuleSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "xrn.modules.navigation"
    }
  },
  "xrnMeta": {
    "name": "XrnNavigation",
    "title": "导航",
    "showName": "导航",
    "group": "路由与导航",
    "description": "提供应用内导航管理，支持多种路由方式",
    "packageName": "@xrnjs/navigation",
    "sdkPath": "routing-navigation/@xrnjs/navigation"
  }
}
