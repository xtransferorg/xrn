{
  "name": "@xrnjs/multi-bundle",
  "version": "0.1.0",
  "description": "支持多 Bundle 加载与管理，优化应用资源使用",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "autoDeployAPIDocs": true,
  "scripts": {
    "build-deps": "npx xrn-tools build-dep-packages @xrnjs/multi-bundle",
    "build": "xrn-module build",
    "clean": "xrn-module clean",
    "lint": "xrn-module lint",
    "prepare": "npx xrn-module prepare",
    "xrn-module": "xrn-module",
    "yalcPublish": "npx yalc publish --push",
    "watch": "nodemon --ignore build/ --ignore lib/ --ignore node_modules/ --watch ./ -C -e js,jsx,ts,tsx,css,less --debug -x 'yarn build && yalc push'"
  },
  "files": [
    "src",
    "build",
    "android",
    "ios",
    "harmony/*.har",
    "harmony/xrn_multi_bundle",
    "!harmony/xrn_multi_bundle/oh_modules",
    "!harmony/xrn_multi_bundle/build",
    "!harmony/xrn_multi_bundle/.hvigor",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "xrn",
    "@xrnjs/multi-bundle",
    "XRNMultiBundle"
  ],
  "repository": "https://github.com/xtransferorg/xrn",
  "bugs": {
    "url": "https://github.com/xtransferorg/xrn/issues"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://xtransferorg.github.io/versions/latest/",
  "devDependencies": {
    "@react-native-oh/react-native-harmony": "0.77.33",
    "@types/react": "^18.2.6",
    "nodemon": "^3.1.1",
    "xrn-module-scripts": "*",
    "xrn-tools": "*"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "harmony": {
    "codegenConfig": {
      "specPaths": [
        "./src"
      ]
    }
  },
  "xrnMeta": {
    "name": "XrnMultiBundle",
    "title": "多 Bundle 管理",
    "showName": "多 Bundle 管理",
    "group": "资源管理",
    "description": "支持多 Bundle 加载与管理，优化应用资源使用",
    "packageName": "@xrnjs/multi-bundle",
    "exportFromCore": false
  }
}
