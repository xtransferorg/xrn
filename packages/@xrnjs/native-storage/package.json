{
  "name": "@xrnjs/native-storage",
  "version": "0.1.0",
  "description": "提供本地数据存储方案，支持持久化存储",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "autoDeployAPIDocs": true,
  "scripts": {
    "build-deps": "npx xrn-tools build-dep-packages @xrnjs/native-storage",
    "build": "xrn-module build",
    "clean": "xrn-module clean",
    "lint": "xrn-module lint",
    "prepare": "npx xrn-module prepare",
    "xrn-module": "xrn-module",
    "yalcPublish": "npx yalc publish --push",
    "watch": "nodemon --ignore build/ --ignore lib/ --ignore node_modules/ --watch ./ -C -e js,jsx,ts,tsx,css,less --debug -x 'yarn build && yalc push'"
  },
  "files": [
    "src",
    "build",
    "android",
    "ios",
    "harmony/*.har",
    "harmony/xrn_native_storage",
    "!harmony/xrn_native_storage/oh_modules",
    "!harmony/xrn_native_storage/build",
    "!harmony/xrn_native_storage/.hvigor",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "xrn",
    "@xrnjs/native-storage",
    "XRNNativeStorage"
  ],
  "repository": "https://github.com/xtransferorg/xrn",
  "bugs": {
    "url": "https://github.com/xtransferorg/xrn/issues"
  },
  "author": "",
  "license": "MIT",
  "homepage": "https://xtransferorg.github.io/versions/latest/sdk/storage/@xrnjs/native-storage",
  "devDependencies": {
    "@react-native-oh/react-native-harmony": "0.77.33",
    "@types/react": "^18.2.6",
    "nodemon": "^3.1.1",
    "react-native": "0.77.1",
    "xrn-module-scripts": "*",
    "xrn-tools": "*"
  },
  "peerDependencies": {
    "@xrnjs/modules-core": "*",
    "react": "*",
    "react-native": "*"
  },
  "harmony": {
    "codegenConfig": {
      "specPaths": [
        "./src"
      ]
    }
  },
  "codegenConfig": {
    "name": "XrnNativeStorageSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "xrn.modules.nativestorage"
    }
  },
  "xrnMeta": {
    "name": "XrnNativeStorage",
    "title": "本地存储",
    "showName": "本地存储",
    "group": "数据存储",
    "description": "提供本地数据存储方案，支持持久化存储",
    "packageName": "@xrnjs/native-storage",
    "sdkPath": "storage/@xrnjs/native-storage"
  }
}
