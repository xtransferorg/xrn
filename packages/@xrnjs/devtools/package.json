{
  "name": "@xrnjs/devtools",
  "version": "0.1.0",
  "description": "开发调试工具",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "autoDeployAPIDocs": false,
  "scripts": {
    "build": "xrn-module build",
    "clean": "xrn-module clean",
    "lint": "xrn-module lint",
    "prepare": "yarn build",
    "xrn-module": "xrn-module",
    "yalcPublish": "xrn-module yalcPublish",
    "watch": "nodemon --ignore build/  --ignore lib/ --ignore node_modules/ --watch ./ -C -e js,jsx,ts,tsx,css,less --debug -x 'npm run build && yalc push'",
    "add-demo-screen-to-xrngo": "yarn prepare && xrn-tools add-demo-screen-to-xrngo"
  },
  "files": [
    "src",
    "build",
    "assets",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "xrn",
    "@xrnjs/devtools",
    "XRNDevTools"
  ],
  "repository": "https://github.com/xtransferorg/xrn",
  "bugs": {
    "url": "https://github.com/xtransferorg/xrn/issues"
  },
  "author": "xtguangqiang",
  "license": "MIT",
  "homepage": "https://github.com/xtransferorg/xrn#readme",
  "dependencies": {
    "@xrnjs/app-utils": "0.1.0",
    "@xrnjs/bundle": "0.1.0",
    "@xrnjs/debug-tools": "0.1.0",
    "@xrnjs/native-storage": "0.1.0",
    "@xrnjs/navigation": "0.1.0",
    "react-native-star-rating-widget": "1.9.2",
    "url-parse": "1.4.4"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "@react-native-clipboard/clipboard": "*",
    "@react-native-community/netinfo": "*",
    "@react-native-cookies/cookies": "*",
    "@xrnjs/modules-core": "*",
    "@xrnjs/react-native-code-push": "*",
    "ahooks": "*",
    "react": "*",
    "react-native": "*",
    "react-native-config": "*",
    "react-native-device-info": "*",
    "react-native-linear-gradient": "*",
    "react-native-safe-area-context": "*",
    "react-native-svg": "*",
    "react-native-vision-camera": "*",
    "react-native-webview": "*"
  },
  "devDependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-clipboard/clipboard": "1.16.2",
    "@xrnjs/app-utils": "0.1.0",
    "@xrnjs/bundle": "0.1.0",
    "@xrnjs/modules-core": "0.1.0",
    "@xrnjs/native-storage": "0.1.0",
    "@xrnjs/navigation": "0.1.0",
    "@xrnjs/react-native-code-push": "0.1.0",
    "ahooks": "3.7.8",
    "nodemon": "^3.1.1",
    "react-native-config": "1.5.5",
    "react-native-device-info": "14.0.4",
    "react-native-linear-gradient": "3.0.0-alpha.1",
    "react-native-safe-area-context": "5.1.0",
    "react-native-svg": "15.12.0",
    "react-native-webview": "13.15.0",
    "xrn-module-scripts": "*"
  }
}
