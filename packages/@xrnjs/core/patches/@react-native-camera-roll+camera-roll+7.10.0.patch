+// Minimal PhotoIdentifier shape when PHAsset cannot be fetched (e.g. add-only library access).
+- (NSDictionary *)convertPlaceholderToDictionary:(NSString *)localIdentifier
+                                         mediaType:(NSString *)mediaType
+                                         sourceURI:(NSURL *)sourceURI
+{
+  NSString *assetMediaTypeLabel = [mediaType isEqualToString:@"video"] ? @"video" : @"image";
+  NSString *uri = [NSString stringWithFormat:@"ph://%@", localIdentifier];
+  NSString *filename = sourceURI.lastPathComponent;
+  if (filename.length == 0) {
+    filename = nil;
+  }
+  NSTimeInterval now = [[NSDate date] timeIntervalSince1970];
+  return @{
+    @"node": @{
+      @"id": localIdentifier,
+      @"type": assetMediaTypeLabel,
+      @"subTypes": @[],
+      @"sourceType": [NSNull null],
+      @"group_name": @[],
+      @"image": @{
+        @"uri": uri,
+        @"extension": filename ? [[filename pathExtension] lowercaseString] : [NSNull null],
+        @"filename": filename ?: [NSNull null],
+        @"filepath": [NSNull null],
+        @"height": [NSNull null],
+        @"width": [NSNull null],
+        @"fileSize": [NSNull null],
+        @"playableDuration": [NSNull null],
+        @"orientation": [NSNull null],
+      },
+      @"timestamp": @(now),
+      @"modificationTimestamp": @(now),
+      @"location": [NSNull null],
+    },
+  };
+}
