+            });
+
+            task.on('fail', (states: Array<loadRequest.TaskState>) => {
+              if (isSettled) return;
+              isSettled = true;
+
+              task.off('complete');
+              task.off('fail');
+              task.off('progress');
+
+              // 清理临时文件
+              this.cleanupTempFiles(tempFiles);
+
+              reject(new Error(states[0]?.message || 'Upload failed'));
+            });
+          })
