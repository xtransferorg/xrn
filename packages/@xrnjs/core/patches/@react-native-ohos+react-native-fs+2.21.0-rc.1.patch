+        this.logger.info(`Cleaned up temp file: ${tempFile}`);
+      } catch (e) {
+        // 文件不存在或其他错误，记录但不抛出
+        this.logger.warn(`Failed to clean up temp file ${tempFile}: ${e?.message}`);
+      }
+    }
