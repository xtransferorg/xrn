+            // 清理临时文件
+            this.cleanupTempFiles(tempFiles);
+            this.logger.error(`uploadFiles error: ${err?.message}`);
+            reject(err);
+          });
+
+      } catch (error) {
+        this.logger.error(`uploadFiles error: ${error?.message}`);
+        reject(error);
+      }
+    });
+  }
