+/*
+ * Copyright (c) XTransfer. All rights reserved.
+ *
+ * ── 核心概念 ──────────────────────────────────────────────────────────────
+ *     task  ──→  bridgeHandler（哪个 Bridge 的 Handler 发起的）
+ *     bridgeHandler ──→  delegate + callbackQueue（回调派发到哪）
+ *   收到 didReceiveData / didComplete 等回调 → 查表 → 转发到对应 Handler 的 queue。
+ *
+ * 【数据流示意】
+ *   Bridge A (Handler A) ──┐
+ *                          ├──→ XTRNURLSessionHub.sharedSessionWithConfiguration ──→ 网络
+ *   Bridge B (Handler B) ──┘              ↑
+ *                                         │ 系统回调先到 Hub
+ *                                         └── 查 _taskBridgeHandlers → 转发给 A 或 B
+ * ─────────────────────────────────────────────────────────────────────────
+ */
+
+#import "XTRNURLSessionHub.h"
+
+#import <mutex>
+
+/// 每个 Bridge Handler（RCTHTTPRequestHandler）的回调上下文
+@interface XTRNBridgeHandlerContext : NSObject
+
+@property (nonatomic, weak) id delegate;
+@property (nonatomic, strong) NSOperationQueue *delegateQueue;
+
+@end
+
+@implementation XTRNBridgeHandlerContext
+
+@end
+
+
+@interface XTRNURLSessionHub () <NSURLSessionDataDelegate, NSURLSessionTaskDelegate>
+
+@end
+
+@implementation XTRNURLSessionHub {
+  NSURLSession *_session;
+  NSOperationQueue *_sessionDelegateQueue;
+
+  /// Bridge Handler（RCTHTTPRequestHandler）→ 回调上下文（delegate + queue）
+  NSMapTable<id, XTRNBridgeHandlerContext *> *_bridgeHandlerContexts;
+
+  /// 路由表：task → Bridge Handler。每次发请求 registerTask，完成/取消 unregisterTask
+  NSMapTable<NSURLSessionTask *, id> *_taskBridgeHandlers;
+
+  std::mutex _mutex;
+}
+
++ (instancetype)shared {
+  static XTRNURLSessionHub *instance;
+  static dispatch_once_t onceToken;
+  dispatch_once(&onceToken, ^{
+    instance = [[XTRNURLSessionHub alloc] init];
+  });
+  return instance;
+}
+
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    _bridgeHandlerContexts = [NSMapTable weakToStrongObjectsMapTable];
+    _taskBridgeHandlers = [NSMapTable strongToWeakObjectsMapTable];
+  }
+  return self;
+}
+
+#pragma mark - Session
+
+- (NSURLSession *)sharedSessionWithConfiguration:(NSURLSessionConfiguration *)configuration {
+  std::lock_guard<std::mutex> lock(_mutex);
+  if (_session != nil) {
+    return _session;
+  }
+
+  // Hub 自己当 Session delegate，所有 Bridge 的请求回调都先到这里
+  _sessionDelegateQueue = [NSOperationQueue new];
+  _sessionDelegateQueue.name = @"com.xt.rn.network.session";
+  _sessionDelegateQueue.maxConcurrentOperationCount = 1;
+
+  _session = [NSURLSession sessionWithConfiguration:configuration delegate:self delegateQueue:_sessionDelegateQueue];
+  return _session;
+}
+
+#pragma mark - Registration（路由表维护）
+
+- (void)registerOwner:(id)owner delegate:(id)delegate delegateQueue:(NSOperationQueue *)delegateQueue {
+  if (owner == nil || delegateQueue == nil) {
+    return;
+  }
+
+  // Handler 首次发请求时调用：记录「这个 Bridge 的回调应派发到 callbackQueue」
+  XTRNBridgeHandlerContext *context = [XTRNBridgeHandlerContext new];
+  context.delegate = delegate;
+  context.delegateQueue = delegateQueue;
+
+  std::lock_guard<std::mutex> lock(_mutex);
+  [_bridgeHandlerContexts setObject:context forKey:owner];
+}
+
+- (void)registerTask:(NSURLSessionTask *)task owner:(id)owner {
+  if (task == nil || owner == nil) {
+    return;
+  }
+
+  // 每次 dataTaskWithRequest + resume 前调用：建立 task → Bridge Handler 映射
+  std::lock_guard<std::mutex> lock(_mutex);
+  [_taskBridgeHandlers setObject:owner forKey:task];
+}
+
+- (void)unregisterTask:(NSURLSessionTask *)task {
+  if (task == nil) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(_mutex);
+  [_taskBridgeHandlers removeObjectForKey:task];
+}
+
+- (void)unregisterOwner:(id)owner cancelTasks:(BOOL)cancelTasks {
+  if (owner == nil) {
+    return;
+  }
+
+  NSMutableArray<NSURLSessionTask *> *tasksToCancel = [NSMutableArray array];
+  XTRNBridgeHandlerContext *context = nil;
+  NSURLSession *session = nil;
+  {
+    std::lock_guard<std::mutex> lock(_mutex);
+    context = [_bridgeHandlerContexts objectForKey:owner];
+    session = _session;
+    [_bridgeHandlerContexts removeObjectForKey:owner];
+
+    // Bridge invalidate 时，清理该 Bridge Handler 下所有 task 的路由条目。
+    // 先收集再删除，避免在 fast enumeration 期间修改 NSMapTable 导致未定义行为。
+    NSMutableArray<NSURLSessionTask *> *tasksToRemove = [NSMutableArray array];
+    for (NSURLSessionTask *task in _taskBridgeHandlers.keyEnumerator) {
+      id bridgeHandler = [_taskBridgeHandlers objectForKey:task];
+      if (bridgeHandler == owner) {
+        [tasksToRemove addObject:task];
+        if (cancelTasks) {
+          [tasksToCancel addObject:task];
+        }
+      }
+    }
+    for (NSURLSessionTask *task in tasksToRemove) {
+      [_taskBridgeHandlers removeObjectForKey:task];
+    }
+  }
+
+  // 共享 Session 下系统 cancel 回调无法再路由到 Handler，主动派发 NSURLErrorCancelled（对齐 invalidateAndCancel）
+  if (cancelTasks && context != nil && tasksToCancel.count > 0) {
+    id delegate = context.delegate;
+    NSOperationQueue *queue = context.delegateQueue;
+    if (delegate != nil && queue != nil) {
+      NSError *error = [NSError errorWithDomain:NSURLErrorDomain code:NSURLErrorCancelled userInfo:nil];
+      for (NSURLSessionTask *task in tasksToCancel) {
+        [queue addOperationWithBlock:^{
+          if ([delegate respondsToSelector:@selector(URLSession:task:didCompleteWithError:)]) {
+            [delegate URLSession:session task:task didCompleteWithError:error];
+          }
+        }];
+      }
+    }
+  }
+
+  for (NSURLSessionTask *task in tasksToCancel) {
+    [task cancel];
+  }
+}
+
+#pragma mark - Delegate forwarding（路由 + 转发）
+
+/// 根据 task 查路由：task → Bridge Handler → delegate/queue（调用方需已持有 _mutex）
+- (nullable XTRNBridgeHandlerContext *)contextForTask:(NSURLSessionTask *)task {
+  id bridgeHandler = [_taskBridgeHandlers objectForKey:task];
+  if (bridgeHandler == nil) {
+    // task 不在路由表，或 Bridge Handler 已释放（weak value 被 zeroed）；顺带清理幽灵条目
+    [_taskBridgeHandlers removeObjectForKey:task];
+    return nil;
+  }
+  return [_bridgeHandlerContexts objectForKey:bridgeHandler];
+}
+
+/// 查路由并派发到 Handler 的 callbackQueue。
+/// unregisterTask 为 YES 时在查路由后立即移除 task 映射（didComplete 专用）
+/// fallback：找不到 delegate 时执行（带 completionHandler 的回调必须调用，否则请求会挂起）
+- (void)dispatchForTask:(NSURLSessionTask *)task unregisterTask:(BOOL)unregisterTask block:(void (^)(id delegate))block fallback:(nullable dispatch_block_t)fallback {
+  XTRNBridgeHandlerContext *context = nil;
+  {
+    std::lock_guard<std::mutex> lock(_mutex);
+    context = [self contextForTask:task];
+    if (unregisterTask) {
+      [_taskBridgeHandlers removeObjectForKey:task];
+    }
+  }
+
+  id delegate = context.delegate;
+  NSOperationQueue *queue = context.delegateQueue;
+  if (delegate == nil || queue == nil) {
+    if (fallback) {
+      fallback();
+    }
+    return;
+  }
+
+  [queue addOperationWithBlock:^{
+    if (block) {
+      block(delegate);
+    }
+  }];
+}
+
+- (void)dispatchForTask:(NSURLSessionTask *)task block:(void (^)(id delegate))block {
+  [self dispatchForTask:task unregisterTask:NO block:block fallback:nil];
+}
+
+- (NSMutableURLRequest *)redirectRequestWithCookies:(NSURLRequest *)request {
+  NSMutableURLRequest *nextRequest = [request mutableCopy];
+  NSArray<NSHTTPCookie *> *cookies = [[NSHTTPCookieStorage sharedHTTPCookieStorage] cookiesForURL:request.URL];
+  nextRequest.allHTTPHeaderFields = [NSHTTPCookie requestHeaderFieldsWithCookies:cookies];
+  return nextRequest;
+}
+
+#pragma mark - NSURLSessionTaskDelegate
+// 以下方法均由系统调用到 Hub（Session 的唯一 delegate），再经 dispatchForTask 转发给 RCTHTTPRequestHandler
+- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task didSendBodyData:(int64_t)bytesSent totalBytesSent:(int64_t)totalBytesSent totalBytesExpectedToSend:(int64_t)totalBytesExpectedToSend {
+  [self dispatchForTask:task block:^(id delegate) {
+    if ([delegate respondsToSelector:@selector(URLSession:task:didSendBodyData:totalBytesSent:totalBytesExpectedToSend:)]) {
+      [delegate URLSession:session task:task didSendBodyData:bytesSent totalBytesSent:totalBytesSent totalBytesExpectedToSend:totalBytesExpectedToSend];
+    }
+  }];
+}
+
+- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task willPerformHTTPRedirection:(NSHTTPURLResponse *)response newRequest:(NSURLRequest *)request completionHandler:(void (^)(NSURLRequest *_Nullable))completionHandler {
+  [self dispatchForTask:task unregisterTask:NO block:^(id delegate) {
+    if ([delegate respondsToSelector:@selector(URLSession:task:willPerformHTTPRedirection:newRequest:completionHandler:)]) {
+      [delegate URLSession:session task:task willPerformHTTPRedirection:response newRequest:request completionHandler:completionHandler];
+    } else {
+      completionHandler([self redirectRequestWithCookies:request]);
+    }
+  } fallback:^{
+    completionHandler([self redirectRequestWithCookies:request]);
+  }];
+}
+
+- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task didFinishCollectingMetrics:(NSURLSessionTaskMetrics *)metrics {
+  [self dispatchForTask:task block:^(id delegate) {
+    if ([delegate respondsToSelector:@selector(URLSession:task:didFinishCollectingMetrics:)]) {
+      [delegate URLSession:session task:task didFinishCollectingMetrics:metrics];
+    }
+  }];
+}
+
+- (void)URLSession:(NSURLSession *)session task:(NSURLSessionTask *)task didCompleteWithError:(NSError *)error {
+  [self dispatchForTask:task unregisterTask:YES block:^(id delegate) {
+    if ([delegate respondsToSelector:@selector(URLSession:task:didCompleteWithError:)]) {
+      [delegate URLSession:session task:task didCompleteWithError:error];
+    }
+  } fallback:nil];
+}
+
+#pragma mark - NSURLSessionDataDelegate
+
+- (void)URLSession:(NSURLSession *)session dataTask:(NSURLSessionDataTask *)task didReceiveResponse:(NSURLResponse *)response completionHandler:(void (^)(NSURLSessionResponseDisposition))completionHandler {
+  [self dispatchForTask:task unregisterTask:NO block:^(id delegate) {
+    if ([delegate respondsToSelector:@selector(URLSession:dataTask:didReceiveResponse:completionHandler:)]) {
+      [delegate URLSession:session dataTask:task didReceiveResponse:response completionHandler:completionHandler];
+    } else {
+      completionHandler(NSURLSessionResponseAllow);
+    }
+  } fallback:^{
+    completionHandler(NSURLSessionResponseAllow);
+  }];
+}
+
+- (void)URLSession:(NSURLSession *)session dataTask:(NSURLSessionDataTask *)task didReceiveData:(NSData *)data {
+  [self dispatchForTask:task block:^(id delegate) {
+    if ([delegate respondsToSelector:@selector(URLSession:dataTask:didReceiveData:)]) {
+      [delegate URLSession:session dataTask:task didReceiveData:data];
+    }
+  }];
+}
+
+@end
