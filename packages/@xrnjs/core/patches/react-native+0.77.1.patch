+/*
+ * Copyright (c) XTransfer. All rights reserved.
+ *
+ * RN 专用共享 NSURLSession。
+ *
+ * 背景：App 里可能有多个 JS Bridge（主包、子包等），每个 Bridge 各有一个 RCTHTTPRequestHandler。
+ * 若各自创建 NSURLSession，TCP/TLS 连接无法跨 Bridge 复用。
+ * 因此全进程只保留一个 NSURLSession，由本 Hub 持有。
+ *
+ * iOS 限制：一个 NSURLSession 只能有一个 delegate（回调接收者）。
+ * Hub 作为唯一 delegate，收到系统回调后，根据「路由表」转发给对应 Bridge 的 Handler。
+ *
+ * Native 侧 HTTP 走 XTNativeURLSessionHub（@xrnjs/network），与本 Hub 无关。
+ */
+
+#import <Foundation/Foundation.h>
+
+NS_ASSUME_NONNULL_BEGIN
+
+@interface XTRNURLSessionHub : NSObject
+
++ (instancetype)shared;
+
+/// 全进程唯一的 RN NSURLSession；configuration 仅在首次创建时使用
+- (NSURLSession *)sharedSessionWithConfiguration:(NSURLSessionConfiguration *)configuration;
+
+/// 注册 Bridge 的 Handler（owner），并声明「该 Bridge 的回调应派发到哪个 queue」
+- (void)registerOwner:(id)owner delegate:(id)delegate delegateQueue:(NSOperationQueue *)delegateQueue;
+
+/// 注册一次 HTTP 请求：把 task 绑定到发起它的 owner（Bridge Handler）
+- (void)registerTask:(NSURLSessionTask *)task owner:(id)owner;
+
+/// 请求结束或取消时，从路由表移除 task
+- (void)unregisterTask:(NSURLSessionTask *)task;
+
+/// Bridge 销毁时注销 owner，可选取消该 Bridge 下所有进行中的 task
+- (void)unregisterOwner:(id)owner cancelTasks:(BOOL)cancelTasks;
+
+@end
+
+NS_ASSUME_NONNULL_END
