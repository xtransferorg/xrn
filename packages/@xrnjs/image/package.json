{
  "name": "@xrnjs/image",
  "version": "0.1.0",
  "description": "XRNImage",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "react-native": "src/index.ts",
  "autoDeployAPIDocs": true,
  "scripts": {
    "build": "xrn-module build",
    "clean": "xrn-module clean",
    "lint": "xrn-module lint",
    "prepare": "xrn-module prepare",
    "xrn-module": "xrn-module",
    "yalcPublish": "xrn-module yalcPublish",
    "add-demo-screen-to-xrngo": "yarn prepare && xrn-tools add-demo-screen-to-xrngo",
    "watch": "nodemon --ignore build/ --watch ./src -C -e js,jsx,ts,tsx,css,less --debug -x 'yalc publish --push'"
  },
  "files": [
    "src",
    "build",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "harmony/*.har",
    "harmony/xrn_image",
    "!harmony/xrn_image/oh_modules",
    "!harmony/xrn_image/build",
    "!harmony/xrn_image/.hvigor",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "keywords": [
    "react-native",
    "xrn",
    "@xrnjs/image",
    "XRNImage"
  ],
  "repository": "https://github.com/xtransferorg/xrn",
  "bugs": {
    "url": "https://github.com/xtransferorg/xrn/issues"
  },
  "author": "XRN",
  "license": "MIT",
  "homepage": "https://github.com/xtransferorg/xrn#readme",
  "devDependencies": {
    "xrn-module-scripts": "*"
  },
  "dependencies": {
    "@react-native-ohos/react-native-fast-image": "8.7.0-rc.2",
    "react-native-fast-image": "8.6.3"
  },
  "peerDependencies": {
    "@xrnjs/modules-core": "*",
    "react": "*",
    "react-native": "*"
  },
  "harmony": {
    "codegenConfig": {
      "specPaths": [
        "./src"
      ]
    }
  },
  "codegenConfig": {
    "name": "xrnimage",
    "type": "all",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "xrn.modules.image"
    },
    "ios": {
      "componentProvider": {
        "XRNImageView": "XrnExpoImageView"
      }
    }
  }
}
